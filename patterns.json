    "(prod\\sparser\\sis\\sdown)",
    "(Issue)(.+)\\n(.+)\\n(.+)",
    "(Prod\\s-\\sFull\\sNode\\sDown\\s-\\sProd)",
    "(\\b\\w+\\s+increased\\s+lag\\s+on\\s+Kafka\\b)",
    "(Triggered|Recovered):\\s*\\[AWS\\]\\s+RDS\\s+CPU\\s+utilization\\s+is\\s+(?:high|back\\s+to\\s+normal)\\s+on\\s+dbinstanceidentifier:[\\w-]+"
